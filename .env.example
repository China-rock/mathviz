# 复制本文件为 .env 后填入真实密钥：cp .env.example .env
# .env 已在 .gitignore 中，不会泄漏到仓库。

DEEPSEEK_API_KEY=sk-在这里填你的密钥

# 可选：若你的 Key 放在一个自定义名字的环境变量里（而非上面这行），
# 把变量名登记在这里，程序会优先去读它。多个用空格分隔。
# DEEPSEEK_API_KEY_ENV_NAME=MY_CUSTOM_KEY_VAR

# 可选：自定义渲染工作目录（默认用系统本地目录，路径必须无空格）
# MATHVIZ_WORK_DIR=C:/Users/你的名字/MathVizWork
